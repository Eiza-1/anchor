{
  "name": "anchor",
  "productName": "Anchor",
  "version": "0.3.0",
  "description": "Open-source Windows optimization — no black boxes.",
  "main": "main/main.js",
  "author": "Eiza-1",
  "license": "MIT",
  "homepage": "https://github.com/Eiza-1/anchor",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build:ui": "vite build",
    "build": "npm run build:ui && electron-builder --win",
    "build:x64": "npm run build:ui && electron-builder --win --x64",
    "build:arm64": "npm run build:ui && electron-builder --win --arm64"
  },
  "dependencies": {
    "electron-updater": "^6.3.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^4.4.0",
    "lucide-react": "^0.417.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.4.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4",
    "vite": "^5.3.5",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.eiza.anchor",
    "productName": "Anchor",
    "publish": [
      {
        "provider": "github",
        "owner": "Eiza-1",
        "repo": "anchor"
      }
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist/**",
      "main/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "AnchorSetup-${version}-${arch}.${ext}",
      "shortcutName": "Anchor"
    }
  }
}
