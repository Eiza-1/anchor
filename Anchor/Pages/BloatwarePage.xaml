<Page
    x:Class="Anchor.Pages.BloatwarePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="using:Anchor.Services">

    <Grid Padding="32,24" MaxWidth="960">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource PageTitle}" Text="Bloatware Removal" />
            <TextBlock Style="{StaticResource CardCaption}" Margin="0,-12,0,12"
                       Text="Uninstall pre-installed Store apps in batches. Apps marked 'Safe to remove' have no system dependencies and can be reinstalled free from the Microsoft Store. Essential apps (Store, Calculator, Photos, Security…) are never listed. A restore point is created before removal." />
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                <Button Content="Load installed apps" Click="Load_Click" />
                <Button Content="Select all safe" Click="SelectSafe_Click" />
                <Button x:Name="RemoveButton" Style="{StaticResource AccentButtonStyle}" Content="Remove selected" Click="Remove_Click" />
                <ProgressRing x:Name="Progress" IsActive="False" Width="24" Height="24" />
            </StackPanel>
            <TextBlock x:Name="ResultText" Style="{StaticResource CardCaption}" Margin="0,0,0,8" />
        </StackPanel>

        <ListView Grid.Row="1" x:Name="AppsList" SelectionMode="Multiple">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="svc:AppxApp">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4">
                        <TextBlock Text="{x:Bind Name}" />
                        <TextBlock Text="✓ Safe to remove" Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                   Visibility="{x:Bind SafeToRemove}" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
