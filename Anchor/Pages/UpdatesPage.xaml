<Page
    x:Class="Anchor.Pages.UpdatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="using:Anchor.Services">

    <ScrollViewer Padding="32,24">
        <StackPanel MaxWidth="900">
            <TextBlock Style="{StaticResource PageTitle}" Text="Windows Update" />

            <Border Style="{StaticResource CardBorder}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource CardHeader}" Text="Am I on a recent stable build?" />
                    <TextBlock x:Name="BuildText" />
                    <TextBlock x:Name="StatusText" Style="{StaticResource CardCaption}" />
                    <ItemsControl x:Name="PendingList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource CardCaption}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="LastInstalledText" Style="{StaticResource CardCaption}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="CheckButton" Content="Check for updates" Click="Check_Click" />
                        <Button Content="Open Windows Update settings" Click="OpenSettings_Click" />
                        <ProgressRing x:Name="Progress" IsActive="False" Width="24" Height="24" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource CardHeader}" Text="Recent — Windows update news" />
                    <TextBlock Style="{StaticResource CardCaption}"
                               Text="Article previews about cumulative, security, and feature updates from WindowsLatest, the Windows Blog, and Windows Central. Click to open in your browser." />
                    <ProgressRing x:Name="NewsProgress" IsActive="True" Width="24" Height="24" HorizontalAlignment="Left" />
                    <ItemsControl x:Name="NewsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="svc:NewsItem">
                                <Border Style="{StaticResource CardBorder}" Margin="0,4">
                                    <StackPanel Spacing="4">
                                        <HyperlinkButton Content="{x:Bind Title}" Click="Article_Click" Tag="{x:Bind Link}" Padding="0" />
                                        <TextBlock Style="{StaticResource CardCaption}" Text="{x:Bind Summary}" />
                                        <TextBlock Style="{StaticResource CardCaption}" Text="{x:Bind Source}" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
