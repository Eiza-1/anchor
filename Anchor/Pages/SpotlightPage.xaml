<Page
    x:Class="Anchor.Pages.SpotlightPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="using:Anchor.Services"
    xmlns:local="using:Anchor.Pages">

    <Grid Padding="32,24" MaxWidth="1000">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource PageTitle}" Text="Tech Spotlight" />
            <TextBlock Style="{StaticResource CardCaption}" Margin="0,-12,0,12"
                       Text="Latest tech news and videos via public feeds — no accounts, no tracking. Click anything to open it in your browser." />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
            <RadioButtons x:Name="ModeSelect" MaxColumns="2" SelectedIndex="0" SelectionChanged="Mode_Changed">
                <x:String>Articles</x:String>
                <x:String>Videos</x:String>
            </RadioButtons>
            <ComboBox x:Name="SourceFilter" SelectionChanged="Filter_Changed" MinWidth="180" VerticalAlignment="Top" />
            <Button Content="Refresh" Click="Refresh_Click" VerticalAlignment="Top" />
            <ProgressRing x:Name="Progress" IsActive="True" Width="24" Height="24" VerticalAlignment="Top" />
        </StackPanel>

        <!-- Articles: thumbnail left, text right -->
        <ListView Grid.Row="2" x:Name="ArticlesList" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Item_Click">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="svc:NewsItem">
                    <Border Style="{StaticResource CardBorder}" Margin="0,4">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="132" Height="84" CornerRadius="6"
                                    VerticalAlignment="Top" Visibility="{x:Bind HasImage}"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                <Image Source="{x:Bind local:SpotlightPage.ToImage(ImageUrl)}"
                                       Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" />
                                <TextBlock Style="{StaticResource CardCaption}" Text="{x:Bind Summary}" MaxLines="2" />
                                <TextBlock Style="{StaticResource CardCaption}" FontWeight="SemiBold" Text="{x:Bind Meta}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Videos: large thumbnail cards in a grid -->
        <GridView Grid.Row="2" x:Name="VideosList" SelectionMode="None" IsItemClickEnabled="True"
                  ItemClick="Item_Click" Visibility="Collapsed">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="svc:NewsItem">
                    <Border Style="{StaticResource CardBorder}" Width="300" Margin="0,4,8,4" Padding="0">
                        <StackPanel>
                            <Grid>
                                <Border Height="168" CornerRadius="8,8,0,0"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                    <Image Source="{x:Bind local:SpotlightPage.ToImage(ImageUrl)}"
                                           Stretch="UniformToFill" />
                                </Border>
                                <!-- play badge -->
                                <Border Background="#B0000000" CornerRadius="18" Width="36" Height="36"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE768;" FontSize="14" Foreground="White" />
                                </Border>
                            </Grid>
                            <StackPanel Padding="12" Spacing="4">
                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" />
                                <TextBlock Style="{StaticResource CardCaption}" FontWeight="SemiBold" Text="{x:Bind Meta}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</Page>
