<Page
    x:Class="Anchor.Pages.PrivacyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="using:Anchor.Services">

    <Grid Padding="32,24" MaxWidth="960">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource PageTitle}" Text="Privacy &amp; Telemetry" />
            <TextBlock Style="{StaticResource CardCaption}" Margin="0,-12,0,12"
                       Text="Each toggle shows exactly which registry value it changes — no hidden behavior, all reversible here. Consider creating a restore point first." />
            <Button Content="Create restore point" Click="Restore_Click" Margin="0,0,0,4" />
            <TextBlock x:Name="RestoreText" Style="{StaticResource CardCaption}" Margin="0,0,0,8" />
        </StackPanel>

        <ListView Grid.Row="1" x:Name="TweaksList" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="svc:PrivacyTweak">
                    <Border Style="{StaticResource CardBorder}" Margin="0,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,12,0">
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource CardCaption}" Text="{x:Bind Description}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind IsApplied}" Toggled="Tweak_Toggled" Tag="{x:Bind}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
