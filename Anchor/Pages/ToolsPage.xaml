<Page
    x:Class="Anchor.Pages.ToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="32,24">
        <StackPanel MaxWidth="900">
            <TextBlock Style="{StaticResource PageTitle}" Text="Advanced Tools" />

            <Border Style="{StaticResource CardBorder}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource CardHeader}" Text="Built-in Windows tools" />
                    <TextBlock Style="{StaticResource CardCaption}"
                               Text="Direct access to Microsoft's own reliable maintenance tools — often the best option." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Disk Cleanup" Click="Tool_Click" Tag="cleanmgr.exe" />
                        <Button Content="Storage Sense" Click="Tool_Click" Tag="ms-settings:storagesense" />
                        <Button Content="Task Scheduler" Click="Tool_Click" Tag="taskschd.msc" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="System Restore" Click="Tool_Click" Tag="rstrui.exe" />
                        <Button Content="Resource Monitor" Click="Tool_Click" Tag="resmon.exe" />
                        <Button Content="Defrag / Optimize Drives" Click="Tool_Click" Tag="dfrgui.exe" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource CardHeader}" Text="Autounattend.xml generator" />
                    <TextBlock Style="{StaticResource CardCaption}"
                               Text="Generates an unattended-setup file to replicate an Anchor-tuned Windows install across multiple PCs. Put the generated file on the root of your install USB. Review the XML before use — it is plain text by design." />
                    <TextBox x:Name="UserNameBox" Header="User name" Text="User" />
                    <TextBox x:Name="ComputerNameBox" Header="Computer name" Text="ANCHOR-PC" />
                    <TextBox x:Name="LocaleBox" Header="Locale" Text="en-US" />
                    <TextBox x:Name="TimeZoneBox" Header="Time zone (e.g. W. Central Africa Standard Time)" Text="UTC" />
                    <CheckBox x:Name="SkipPrivacyBox" Content="Skip OOBE privacy questions (applies most-private answers)" IsChecked="True" />
                    <CheckBox x:Name="TelemetryBox" Content="Disable telemetry on first login" IsChecked="True" />
                    <CheckBox x:Name="LocalAccountBox" Content="Local account setup (skip Microsoft account requirement)" IsChecked="True" />
                    <CheckBox x:Name="BypassBox" Content="Bypass TPM / Secure Boot / RAM checks (unsupported hardware installs)" />
                    <Button Content="Generate Autounattend.xml" Click="Generate_Click" Style="{StaticResource AccentButtonStyle}" />
                    <TextBlock x:Name="GenResultText" Style="{StaticResource CardCaption}" IsTextSelectionEnabled="True" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
